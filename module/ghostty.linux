font-size = 12
font-family = Berkeley Mono
font-style-bold = Bold
font-style-italic = Italic
font-style-bold-italic = Bold Italic
font-family = nonicons

mouse-hide-while-typing = true
window-padding-x = 0
window-padding-y = 0
window-decoration = false
gtk-titlebar = false
gtk-tabs-location = bottom
gtk-wide-tabs = false
adw-toolbar-style = flat

keybind = ctrl+enter=unbind

theme = SpaceGray
# theme = Hybrid 
# theme = NvimDark 

background = 161719
# background = #111111
# cursor-color = #ffffff

# Modify builtin `NvimDark` theme to my custom colours

# cyan
# palette = 6=#98f9f8
# palette = 14=#98f9f8

