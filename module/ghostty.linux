font-size = 10
font-family = Berkeley Mono
font-style-bold = Bold
font-style-italic = Oblique
font-style-bold-italic = Bold Oblique
font-family = nonicons

mouse-hide-while-typing = true

# Commenting out window decoration and padding options so that the default value is used for KDE Plasma 6:
window-decoration = server
# window-decoration = false
# window-padding-x = 0
# window-padding-y = 0
window-title-font-family = Noto Sans

gtk-titlebar = true
# gtk-tabs-location = bottom
# gtk-wide-tabs = false


# gtk-adwaita = false
# adw-toolbar-style = flat

keybind = ctrl+shift+w=close_surface

keybind = ctrl+enter=unbind

theme = SpaceGray
background = 161719
selection-background = #3A404A
# selection-background = #41454E
